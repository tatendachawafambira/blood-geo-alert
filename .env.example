# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never hold a real value.

# Generate each with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
BGA_FIELD_KEY=
BGA_BLIND_PEPPER=

DATABASE_URL_OWNER=postgresql+psycopg://bga_owner:change_me_locally@127.0.0.1:5432/bga
DATABASE_URL_APP=postgresql+psycopg://bga_app:app_pw_change_me@127.0.0.1:5432/bga
DATABASE_URL_AUDIT=postgresql+psycopg://bga_audit:audit_pw_change_me@127.0.0.1:5432/bga
DATABASE_URL_DONOR=postgresql+psycopg://bga_donor:donor_pw_change_me@127.0.0.1:5432/bga

# The address a donor's phone uses to reach the donor app (port 8001).
DONOR_BASE_URL=http://127.0.0.1:8001

# --- SMS gateway --------------------------------------------------------
# mock sends nothing. android and twilio send a real SMS, but only to numbers
# on SMS_ALLOWLIST - empty blocks every real send.
PRIMARY_GATEWAY=mock
SECONDARY_GATEWAY=mock
SMS_ALLOWLIST=

# Android handset running android-sms-gateway in local server mode
ANDROID_SMS_URL=
ANDROID_SMS_USERNAME=
ANDROID_SMS_PASSWORD=

# Twilio (trial accounts send only to verified numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK=
